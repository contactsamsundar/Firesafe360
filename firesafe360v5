# ── Sensor Processing (ESP32 Serial Tracking History) ─────────────────────────
class SensorMonitor:
    def __init__(self, port, baud):
        self.port = port
        self.baud = baud
        self.connected = False
        self.latest_data = {}
        self.history = deque(maxlen=13) 
        self.thread = threading.Thread(target=self._read_loop, daemon=True)
        self.thread.start()

    def _read_loop(self):
        while True:
            try:
                ser = serial.Serial(self.port, self.baud, timeout=1)
                self.connected = True
                ser.reset_input_buffer()
                
                while self.connected:
                    start_time = time.time()
                    
                    if ser.in_waiting > 0:
                        line = ser.readline().decode('utf-8', errors='ignore').strip()
                        if not line or "Temp,Humidity" in line:
                            continue
                        
                        data = line.split(',')
                        if len(data) == 5:
                            raw_temp = data[0]
                            temp_val = float(raw_temp) if raw_temp != 'NaN' else None
                            
                            temp_str = raw_temp + " °C" if raw_temp != 'NaN' else "Sensor Error"
                            hum_str = data[1] + " %" if data[1] != 'NaN' else "Sensor Error"
                            alarm_status = "ACTIVE 🚨" if data[4] == '1' else "CLEAR ✅"
                            
                            self.latest_data = {
                                "temp_numeric": temp_val,
                                "temp": temp_str,
                                "hum": hum_str,
                                "flame": data[2],
                                "smoke": data[3],
                                "alarm": alarm_status,
                                "alarm_raw": data[4],
                                "timestamp": time.time()
                            }
                            
                            if temp_val is not None:
                                self.history.append((time.time(), temp_val))
                                
                    elapsed = time.time() - start_time
                    if elapsed < 5.0:
                        time.sleep(5.0 - elapsed)
                        
            except serial.SerialException:
                self.connected = False
                self.latest_data = {"error": "Connection Lost / Port Closed"}
                time.sleep(2)
            except Exception:
                pass

    def get_historical_ror(self):
        if len(self.history) < 2:
            return {"status": "INSUFFICIENT DATA", "reason": "Gathering historical baseline..."}
        
        current_time, current_temp = self.history[-1]
        target_time = current_time - 60.0
        past_entry = min(self.history, key=lambda x: abs(x[0] - target_time))
        past_time, past_temp = past_entry
        
        actual_interval = current_time - past_time
        if actual_interval < 45.0:
            return {"status": "INSUFFICIENT DATA", "reason": f"Only {actual_interval:.1f}s of history gathered..."}
            
        temp_diff = current_temp - past_temp
        pct_diff = (temp_diff / past_temp) * 100 if past_temp != 0 else 0.0
        ror_detected = temp_diff >= 8.3
        
        return {
            "status": "COMPLETED",
            "detected": ror_detected,
            "past_temp": f"{past_temp:.1f} °C",
            "current_temp": f"{current_temp:.1f} °C",
            "diff": f"{temp_diff:+.1f} °C",
            "pct_diff": f"{pct_diff:+.1f}%",
            "interval": f"{actual_interval:.1f}s ago"
        }

# ── Audio Processing (YAMNet) ────────────────────────────────────────────────
class YAMNetClassifier:
    def __init__(self):
        if not SAVED_MODEL.exists():
            print(f"[!] Model not found at {SAVED_MODEL}.")
            sys.exit(1)

        os.environ["TF_CPP_MIN_LOG_LEVEL"] = "3"
        tf.get_logger().setLevel("ERROR")
        self.model = tf.saved_model.load(str(SAVED_MODEL))

        try:
            with open(CLASS_MAP) as f:
                self.class_names = json.load(f)
        except FileNotFoundError:
            print(f"[!] Could not find {CLASS_MAP}.")
            sys.exit(1)

    def predict(self, waveform: np.ndarray):
        scores, embeddings, spectrogram = self.model(waveform)
        scores_np = scores.numpy()
        mean_scores = scores_np.mean(axis=0)

        top5_idx = mean_scores.argsort()[-5:][::-1]
        top5     = [(self.class_names[i], float(mean_scores[i])) for i in top5_idx]
        return top5[0][0], top5[0][1], top5

def record_clip(duration=CLIP_SECONDS, sr=SAMPLE_RATE, progress_cb=None):
    frames = int(sr * duration)
    audio  = sd.rec(frames, samplerate=sr, channels=1, dtype='float32')
    for i in range(duration):
        time.sleep(1)
        if progress_cb: progress_cb(i + 1, duration)
    sd.wait()
    wav = audio.flatten()
    peak = np.abs(wav).max()
    if peak > 1e-6: wav = wav / peak
    return wav

# ── Vision Processing (YOLO) ─────────────────────────────────────────────────
def infer_one_model(model_row, image_path):
    result = {
        "model_name": model_row["name"],
        "status": "FAILED",
        "detections": "",
        "max_confidence": 0.0,
        "max_detection_label": "NONE", 
        "error": "",
    }
    try:
        model = YOLO(model_row["local_path"])
        outputs = model.predict(source=str(image_path), conf=CONF_THRESHOLD, verbose=False)
        
        detections = []
        max_conf, max_label = 0.0, "NONE"

        for output in outputs:
            names = output.names
            if output.boxes is None: continue

            for box in output.boxes:
                cls_id = int(box.cls[0])
                conf = float(box.conf[0])
                label = names.get(cls_id, str(cls_id))
                detections.append(f"{label}:{conf:.2f}")
                
                if conf > max_conf:
                    max_conf = conf
                    max_label = label

        result["status"] = "OK"
        result["detections"] = ", ".join(detections) if detections else "NO DETECTION"
        result["max_confidence"] = max_conf
        result["max_detection_label"] = max_label 

    except Exception as e:
        result["error"] = str(e)

    return result

# ── Unified Terminal Display ─────────────────────────────────────────────────
class UnifiedDisplay:
    def __init__(self, sensor_monitor):
        self.term = blessed.Terminal()
        self.lock = threading.Lock()
        self.sensor_monitor = sensor_monitor
        
        self.audio_state = "idle"
        self.audio_result = None
        self.audio_elapsed = 0
        
        self.vision_state = "idle"
        self.vision_result_df = None
        self.vision_current_model = ""

        self.sensor_state = "idle"
        self.sensor_snapshot = {}
        self.ror_snapshot = {}

    def compute_sensor_fusion(self):
        """
        Evaluates criteria from all modes to determine system state.
        Strictly filters for FIRE indicators and omits smoke anomalies.
        """
        fire_detected = False
        reasons = []

        # 1. Evaluate ESP32 Hardware Data (Ignoring Smoke field)
        if self.sensor_state == "result" and self.sensor_snapshot:
            if self.sensor_snapshot.get("alarm_raw") == '1':
                fire_detected = True
                reasons.append("ESP32 Flame/Thermal Hardware Interrupt Triggered")
            
            if self.ror_snapshot.get("status") == "COMPLETED" and self.ror_snapshot.get("detected"):
                fire_detected = True
                reasons.append("Thermal Rate of Rise exceeded limit (>= 8.3°C/min)")

        # 2. Evaluate YOLO Vision Data (Filtering out Smoke classifications)
        if self.vision_state == "result" and self.vision_result_df is not None:
            for _, row in self.vision_result_df.iterrows():
                label = str(row.get("max_detection_label", "")).lower()
                conf = row.get("max_confidence", 0.0)
                
                # Check for "fire" but explicitly bypass "smoke" detections
                if "fire" in label and "smoke" not in label and conf > 0.50:
                    fire_detected = True
                    reasons.append(f"Vision Fire Match: {row['model_name']} detected '{label}' ({conf*100:.1f}%)")

        # 3. Evaluate YAMNet Audio Data (Ignoring pure smoke acoustic properties)
        if self.audio_state == "result" and self.audio_result:
            top_class, conf, _ = self.audio_result
            top_class_lower = top_class.lower()
            
            audio_fire_keywords = ["fire", "crackle", "explosion", "siren", "smoke detector"]
            if any(kw in top_class_lower for kw in audio_fire_keywords):
                fire_detected = True
                reasons.append(f"Audio Fire Acoustic Match: '{top_class}' ({conf*100:.1f}%)")

        if fire_detected:
            return "FIRE DETECTED 🚨", reasons
        return "NORMAL ✅", ["All monitoring modes reporting within standard parameters. No fire vectors detected."]

    def render(self):
        with self.lock:
            t = self.term
            print(t.home + t.clear, end="")
            
            print(t.bold + t.color_rgb(255, 106, 0) + "FIRESAFE 360" + t.normal)
            
            print(t.bold + t.yellow + "  🔊📷🌡️  Triple Multimodal Surveillance System (Audio + Vision + Sensors)" + t.normal)
            print("  " + "=" * 76)
            print("  Controls: " + t.yellow + "F1" + t.normal + " = Scan All | " + 
                  t.yellow + "TAB" + t.normal + " = Clear | " + 
                  t.yellow + "Q/ESC" + t.normal + " = Quit")
            print(t.red + "  [!] Note: Click the WEBCAM WINDOW for keys to register!" + t.normal)
            print("  " + "-" * 76)

            # --- SENSOR STATUS BLOCK ---
            print(t.bold + "\n🌡️ ESP32 SENSOR MODULE (5s Sampling)" + t.normal)
            if self.sensor_state == "result":
                if not self.sensor_monitor.connected:
                    print("Status: " + t.red + "OFFLINE - NO DATA CAPTURED" + t.normal)
                else:
                    print("Status: " + t.green + "SNAPSHOT CAPTURED" + t.normal)
                
                d = self.sensor_snapshot
                print(f"  Current Temp  : {d.get('temp', 'N/A')}")
                print(f"  Humidity      : {d.get('hum', 'N/A')}")
                print(f"  Flame Raw     : {d.get('flame', 'N/A')}")
                print(f"  Smoke Raw     : {d.get('smoke', 'N/A')} [Ignored by Fusion Engine]")
                print(f"  Alarm Status  : {d.get('alarm', 'N/A')}")
                
                print(t.bold + "  --- Rate of Rise (RoR) 60s Analysis ---" + t.normal)
                ror = self.ror_snapshot
                if ror.get("status") == "COMPLETED":
                    print(f"    Baseline Temp ({ror['interval']}): {ror['past_temp']}")
                    print(f"    Current Scan Temp         : {ror['current_temp']}")
                    print(f"    Net Delta / Change        : {ror['diff']} ({ror['pct_diff']})")
                    
                    if ror["detected"]:
                        print("    RoR Status                : " + t.bold + t.white_on_red + " 🚨 FIRE DETECTED (Abnormal Temp Rise >= 8.3°C) " + t.normal)
                    else:
                        print("    RoR Status                : " + t.green + "✅ NO RATE OF RISE DETECTED (Normal)" + t.normal)
                else:
                    print(f"    RoR Status                : {t.yellow}{ror.get('reason', 'Processing...')}{t.normal}")
                
            elif not self.sensor_monitor.connected:
                print("Status: " + t.red + f"OFFLINE (Searching for {SERIAL_PORT}...)" + t.normal)
            elif self.sensor_state == "idle":
                print("Status: READY (Monitoring and logging history every 5 seconds)")

            # --- VISION STATUS BLOCK ---
            print(t.bold + "\n📷 VISION MODULE" + t.normal)
            if self.vision_state == "idle":
                print("Status: READY")
            elif self.vision_state == "analysing":
                print(f"Status: ANALYSING... (Running: {t.cyan}{self.vision_current_model}{t.normal})")
            elif self.vision_state == "result":
                print("Status: " + t.green + "SCAN COMPLETE" + t.normal)
                if self.vision_result_df is not None:
                    df_print = self.vision_result_df.copy()
                    df_print["max_confidence"] = df_print["max_confidence"].map(lambda x: f"{x:.2f}")
                    print("\n" + df_print.to_string(index=False))

            # --- AUDIO STATUS BLOCK ---
            print(t.bold + "\n🎤 AUDIO MODULE" + t.normal)
            if self.audio_state == "idle":
                print("Status: READY")
            elif self.audio_state == "recording":
                print(f"Status: RECORDING... ({self.audio_elapsed} / {CLIP_SECONDS}s) - Make noise!")
            elif self.audio_state == "analysing":
                print("Status: ANALYSING with YAMNet...")
            elif self.audio_state == "result":
                print("Status: " + t.green + "SCAN COMPLETE" + t.normal)
                top_class, conf, top5 = self.audio_result
                print("\n" + t.bold + t.green + f"🎯 Top Audio Match: {top_class.upper()} ({conf*100:.1f}%)" + t.normal)
                print("Top 5 Detected:")
                for i, (name, score) in enumerate(top5):
                    color = t.green if i == 0 else t.white
                    print(color + f"  {i+1}. {name:<20} {score*100:>5.1f}%" + t.normal)

            # --- MULTIMODAL SENSOR FUSION BLOCK ---
            print("\n" + "=" * 78)
            print(t.bold + "📊 FIRESAFE 360 SENSOR FUSION DECISION ENGINE" + t.normal)
            print("=" * 78)
            
            fusion_status, triggers = self.compute_sensor_fusion()
            if "FIRE DETECTED" in fusion_status:
                print("Final Fusion Assessment: " + t.bold + t.white_on_red + f" {fusion_status} " + t.normal)
                print(t.red + "Active Threat Vectors Detected:" + t.normal)
                for trigger in triggers:
                    print(f"  ⚠ {trigger}")
            else:
                print("Final Fusion Assessment: " + t.bold + t.green + f" {fusion_status} " + t.normal)
                print("System Diagnosis details:")
                for trigger in triggers:
                    print(f"  • {trigger}")
            print("=" * 78)

            sys.stdout.flush()

# ── Main Event Loop ──────────────────────────────────────────────────────────
def main():
    print("Loading AI Models and opening Serial port, please wait...")
    yamnet_detector = YAMNetClassifier()
    yolo_models = [m for m in get_yolo_models() if m.get("status") == "OK" and m.get("local_path")]
    sensor_monitor = SensorMonitor(SERIAL_PORT, BAUD_RATE)
    
    display = UnifiedDisplay(sensor_monitor)
    
    cap = cv2.VideoCapture(CAMERA_INDEX)
    if not cap.isOpened():
        raise RuntimeError("Could not open webcam.")

    audio_busy = False
    vision_busy = False

    def audio_task():
        nonlocal audio_busy
        audio_busy = True
        try:
            def on_progress(elapsed, total):
                display.audio_elapsed = elapsed
                display.audio_state = "recording"
                display.render()

            waveform = record_clip(progress_cb=on_progress)
            display.audio_state = "analysing"
            display.render()
            
            top_class, conf, top5 = yamnet_detector.predict(waveform)
            
            display.audio_result = (top_class, conf, top5)
            display.audio_state = "result"
            display.render()
        finally:
            audio_busy = False

    def vision_task(frame_to_process, image_path):
        nonlocal vision_busy
        vision_busy = True
        try:
            cv2.imwrite(str(image_path), frame_to_process)
            all_results = []
            
            for m in yolo_models:
                display.vision_state = "analysing"
                display.vision_current_model = m['name']
                display.render()
                
                res = infer_one_model(m, image_path)
                all_results.append(res)
                
            display.vision_result_df = pd.DataFrame(all_results)
            display.vision_state = "result"
            display.render()
        finally:
            vision_busy = False

    display.render()

    while True:
        ok, frame = cap.read()
        if not ok:
            time.sleep(0.1)
            continue

        cv2.imshow("Webcam - F1: Scan All | TAB: Clear | Q/Esc: Quit", frame)

        key = cv2.waitKeyEx(1)
        if key == -1:
            continue

        if key in F1_KEYS:
            if not audio_busy and not vision_busy:
                if sensor_monitor.connected:
                    display.sensor_snapshot = sensor_monitor.latest_data.copy()
                    display.ror_snapshot = sensor_monitor.get_historical_ror()
                else:
                    display.sensor_snapshot = {}
                    display.ror_snapshot = {"status": "FAILED", "reason": "ESP32 Disconnected"}
                
                display.sensor_state = "result"

                timestamp = time.strftime("%Y%m%d_%H%M%S")
                image_path = CAPTURE_DIR / f"capture_{timestamp}.jpg"
                
                threading.Thread(target=audio_task, daemon=True).start()
                threading.Thread(target=vision_task, args=(frame.copy(), image_path), daemon=True).start()

                display.render()

        elif key == 9:
            if not audio_busy and not vision_busy:
                display.audio_state = "idle"
                display.vision_state = "idle"
                display.sensor_state = "idle"
                
                display.audio_result = None
                display.vision_result_df = None
                display.sensor_snapshot = {}
                display.ror_snapshot = {}
                display.render()

        elif key in [ord("q"), ord("Q"), 27]:
            print("\nExiting program...")
            break

    cap.release()
    cv2.destroyAllWindows()

if __name__ == "__main__":
    main()
